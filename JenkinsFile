pipeline{
    agent any

    environment{
        DOCKER_CREDENTIAL = credentials('dockerhub-credentials')
    }

    stages{
        stage('Pulling Code'){
            steps{
                git branch: 'main', credentialsId: 'my-app', url: 'https://github.com/Ahmed-Nazar/Webapp-with-Pipeline-Docker.git'
            }
        }

        stage('Build'){
            steps{
                sh 'docker build -t ahmednazar2002/health-web:latest .'
            }
        }

        stage('login to docker'){
            steps{
                sh '''
                    echo $DOCKER_CREDENTIAL_PSW | docker login \
                    -u $DOCKER_CREDENTIAL_USR --password-stdin
                    '''
            }
        }

        stage('push image'){
            steps{
                sh 'docker push ahmednazar2002/health-web:latest'
            }
        }

        stage('connect vm & deploy'){
            steps{
                sshagent(credentials: ['debian-pc']){
                    sh '''
                        ssh -o StrictHostKeyChecking=accept-new debian@192.168.8.156 "
                        docker pull ahmednazar2002/health-web:latest &&\
                        docker logout &&\
                        docker rm -f health-web || true && \
                        docker run -d \
                        -p 5000:5000 \
                        --name health-web \
                        --restart unless-stopped\
                        ahmednazar2002/health-web:latest "
                        '''

                }
            }
        }

        
    }
}